<Window x:Class="ReportDataMaker.Views.DataEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReportDataMaker.ViewModels"
        Title="{Binding Title}"
        Width="750" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,12"/>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 可编辑元素 -->
                <TextBlock Text="&#x25BC;  可编辑字段"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           Margin="0,4,0,10"
                           Visibility="{Binding EditableElements.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding EditableElements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label, StringFormat='{}{0}:'}"
                                               Width="130"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#64748B"/>

                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Resources>
                                            <DataTemplate DataType="{x:Type vm:EditableDropdownViewModel}">
                                                <ComboBox Width="250" Height="28"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:EditableDateViewModel}">
                                                <DatePicker Width="250" Height="28"
                                                            SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:EditableNumberViewModel}">
                                                <TextBox Width="250" Height="28"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:EditableTextViewModel}">
                                                <TextBox Width="250" Height="28"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:EditableElementViewModel}">
                                                <TextBox Width="250" Height="28"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </ContentControl.Resources>
                                    </ContentControl>

                                    <TextBlock Text="{Binding DataPath, StringFormat=' \u2192 {0}'}"
                                               FontSize="10"
                                               Foreground="#0EA5E9"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ValidationError}"
                                           Foreground="#EF4444"
                                           FontSize="10"
                                           Margin="135,2,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 适配器元素 -->
                <TextBlock Text="&#x25BC;  数据适配器字段（只读）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#10B981"
                           Margin="0,16,0,10"
                           Visibility="{Binding AdapterElements.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding AdapterElements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="{Binding Label, StringFormat='{}{0}:'}"
                                           Width="130"
                                           VerticalAlignment="Center"
                                           Foreground="#10B981"
                                           FontSize="12"/>

                                <TextBlock Text="{Binding DisplayValue}"
                                           Width="250"
                                           Background="#ECFDF5"
                                           Foreground="#065F46"
                                           Padding="8,4"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="  [数据适配器]"
                                           FontSize="10"
                                           Foreground="#10B981"
                                           VerticalAlignment="Center"
                                           Margin="6,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确认录入"
                        Width="100" Height="32"
                        Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand"
                        Command="{Binding ConfirmCommand}"/>
                <Button Content="取消"
                        Width="80" Height="32"
                        Background="White" Foreground="#64748B"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        FontSize="13" Cursor="Hand"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
