<UserControl x:Class="ReportDataMaker.Views.Tabs.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:infra="clr-namespace:ReportDataMaker.Infrastructure"
             xmlns:converters="clr-namespace:ReportDataMaker.Converters">

    <UserControl.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <converters:TableDataConverter x:Key="TableDataConverter"/>

        <!-- ReadOnly field (gray label display) -->
        <DataTemplate x:Key="ReadOnlyFieldTemplate">
            <TextBlock Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                       Text="{Binding Value, Mode=OneWay}"/>
        </DataTemplate>

        <!-- Text field -->
        <DataTemplate x:Key="TextFieldTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="#475569" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,5" FontSize="13"/>
            </Grid>
        </DataTemplate>

        <!-- Multi-line text field -->
        <DataTemplate x:Key="MultiLineTextFieldTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label}" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="150"
                         VerticalScrollBarVisibility="Auto" Padding="8,5" FontSize="13"/>
            </StackPanel>
        </DataTemplate>

        <!-- Dropdown field -->
        <DataTemplate x:Key="DropdownFieldTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="#475569" FontSize="13" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center" Padding="8,5" FontSize="13" MinHeight="30"/>
            </Grid>
        </DataTemplate>

        <!-- Number field -->
        <DataTemplate x:Key="NumberFieldTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="#475569" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,5" FontSize="13"
                         HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                           Foreground="#94A3B8" FontSize="13" Margin="6,0,0,0"
                           Visibility="{Binding Unit, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- Date field -->
        <DataTemplate x:Key="DateFieldTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="#475569" FontSize="13" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13" VerticalContentAlignment="Center" Padding="4,4"/>
            </Grid>
        </DataTemplate>

        <!-- Checkbox field -->
        <DataTemplate x:Key="CheckboxFieldTemplate">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                      Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center"/>
        </DataTemplate>

        <!-- Table field -->
        <DataTemplate x:Key="TableFieldTemplate">
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="#475569" FontSize="13" Margin="12,8"/>
                    <DataGrid AutoGenerateColumns="True"
                              CanUserAddRows="True"
                              CanUserDeleteRows="False"
                              MinHeight="100"
                              MaxHeight="300"
                              Margin="12,0,12,8"
                              CellEditEnding="DataGrid_CellEditEnding"
                              AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">
                        <DataGrid.ItemsSource>
                            <MultiBinding Converter="{StaticResource TableDataConverter}">
                                <Binding Path="TableCellData" />
                                <Binding Path="TableHeaderRows" />
                            </MultiBinding>
                        </DataGrid.ItemsSource>
                    </DataGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="从适配器填充" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding FillFromAdapterCommand}" Margin="0,0,8,0" MinHeight="30"/>
                    <Button Content="清空所有" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearAllCommand}" MinHeight="30"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新预览" Style="{StaticResource ButtonInfo}"
                            Command="{Binding RefreshCommand}" Margin="0,0,12,0" MinHeight="30"/>
                    <Slider Minimum="50" Maximum="200" Value="{Binding ZoomLevel}" Width="120"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0:F0}%}"
                               VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Form with Expanders -->
            <ScrollViewer Grid.Column="0" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <StackPanel Margin="12,8,12,8">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="12,8,12,4">
                                        <ItemsControl.ItemTemplateSelector>
                                            <infra:FieldDataTemplateSelector
                                                TextTemplate="{StaticResource TextFieldTemplate}"
                                                MultiLineTextTemplate="{StaticResource MultiLineTextFieldTemplate}"
                                                DropdownTemplate="{StaticResource DropdownFieldTemplate}"
                                                NumberTemplate="{StaticResource NumberFieldTemplate}"
                                                DateTemplate="{StaticResource DateFieldTemplate}"
                                                CheckboxTemplate="{StaticResource CheckboxFieldTemplate}"
                                                RadioTemplate="{StaticResource DropdownFieldTemplate}"
                                                ReadOnlyTemplate="{StaticResource ReadOnlyFieldTemplate}"
                                                TableTemplate="{StaticResource TableFieldTemplate}"/>
                                        </ItemsControl.ItemTemplateSelector>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Unsupported elements panel -->
                    <Expander Header="未完全支持的元素" IsExpanded="False" Margin="0,4,0,0"
                              Visibility="{Binding UnsupportedElements.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl ItemsSource="{Binding UnsupportedElements}" Margin="12,8,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FDE68A" BorderThickness="1" Background="#FFFBEB"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ElementType}" FontWeight="SemiBold"
                                                           Foreground="#92400E" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#A16207"
                                                           FontSize="12" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Reason}" Foreground="#CA8A04"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Preview -->
            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ContentControl Content="{Binding PreviewVisual}" RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ContentControl.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel, Converter={StaticResource DoubleConverter}, ConverterParameter='0.01'}"
                                           ScaleY="{Binding ZoomLevel, Converter={StaticResource DoubleConverter}, ConverterParameter='0.01'}"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
