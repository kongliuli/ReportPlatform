<UserControl x:Class="ReportDataMaker.Views.Tabs.ContextAdapterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <Border Style="{StaticResource BorderRegion}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="配置方案" Style="{StaticResource TextBlockSectionTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfileName}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="新建" Command="{Binding NewProfileCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="删除" Command="{Binding DeleteProfileCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BorderRegion}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="静态值" Style="{StaticResource TextBlockSectionTitle}" />

                    <!-- Unconfigured fields quick-add area -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding UnconfiguredFields}"
                                      SelectedItem="{Binding SelectedUnconfiguredField}"
                                      DisplayMemberPath="DisplayText"
                                      Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="添加字段" Command="{Binding AddFromUnconfiguredCommand}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="检测" Command="{Binding DetectUnconfiguredCommand}" Style="{StaticResource ButtonInfo}"/>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding StaticValues}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="0,4,0,0" HeadersVisibility="Column" MinHeight="80">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="字段名" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DataPath" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="静态值" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="+" Command="{Binding AddStaticValueCommand}" Margin="0,0,4,0"/>
                        <Button Content="-" Command="{Binding RemoveStaticValueCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BorderRegion}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="预览" Style="{StaticResource TextBlockSectionTitle}" />
                    <Button Content="预览" Command="{Binding PreviewCommand}" Style="{StaticResource ButtonInfo}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                    <DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="0,4,0,0" HeadersVisibility="Column" MinHeight="80" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="DataPath" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataPath}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="值" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="来源" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Source}" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource ButtonSuccess}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="应用" Command="{Binding ApplyCommand}" Style="{StaticResource ButtonPrimary}" Margin="6,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource BorderRegion}">
                <StackPanel>
                    <TextBlock Text="状态" Style="{StaticResource TextBlockSectionTitle}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
