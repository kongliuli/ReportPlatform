<UserControl x:Class="ReportDataMaker.Views.Tabs.DataEntryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:ReportDataMaker.Converters"
             xmlns:vmtabs="clr-namespace:ReportDataMaker.ViewModels.Tabs">

    <UserControl.Resources>
        <converters:TableDataConverter x:Key="TableDataConverter"/>

        <!-- Default (non-table) field template -->
        <DataTemplate x:Key="DefaultFieldTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DataPath}" Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="300"/>
            </StackPanel>
        </DataTemplate>

        <!-- Table field template -->
        <DataTemplate x:Key="TableFieldTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DataPath}" Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
                <DataGrid AutoGenerateColumns="True"
                          CanUserAddRows="True"
                          CanUserDeleteRows="False"
                          MinHeight="100"
                          MaxHeight="400"
                          Margin="0,4,0,4"
                          CellEditEnding="DataGrid_CellEditEnding"
                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">
                    <DataGrid.ItemsSource>
                        <MultiBinding Converter="{StaticResource TableDataConverter}">
                            <Binding Path="TableCellData" />
                            <Binding Path="TableHeaderRows" />
                        </MultiBinding>
                    </DataGrid.ItemsSource>
                </DataGrid>
            </StackPanel>
        </DataTemplate>

        <converters:FieldTemplateSelector x:Key="FieldTemplateSelector"
            DefaultFieldTemplate="{StaticResource DefaultFieldTemplate}"
            TableFieldTemplate="{StaticResource TableFieldTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="从适配器填充" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"/>
            <Button Content="清空所有"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}"
                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                          Margin="0,8,0,0"/>
        </ScrollViewer>
    </Grid>
</UserControl>
