<UserControl x:Class="ReportDataMaker.Views.ExpanderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="6" Margin="0,0,0,10">
        <Expander IsExpanded="True">
            <Expander.Header>
                <Grid Background="Transparent" Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Icon}"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Count, StringFormat='({0})'}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Expander.Header>

            <Border Padding="12,6,12,12">
                <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=PanelContent}"/>
            </Border>
        </Expander>
    </Border>
</UserControl>
