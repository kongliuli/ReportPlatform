<Window x:Class="ReportDataMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ReportDataMaker - 报告单数据录入工具"
        Height="780" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 菜单栏 ===== -->
        <Menu Grid.Row="0">
            <MenuItem Header="_文件">
                <MenuItem Header="_加载模板" InputGestureText="Ctrl+O" Click="MenuItemLoadTemplate_Click"/>
                <MenuItem Header="_保存数据" InputGestureText="Ctrl+S" Click="MenuItemSaveData_Click"/>
                <Separator/>
                <MenuItem Header="_退出" InputGestureText="Alt+F4" Click="MenuItemExit_Click"/>
            </MenuItem>
            <MenuItem Header="_视图">
                <MenuItem Header="_刷新预览" InputGestureText="F5" Click="MenuItemRefreshPreview_Click"/>
                <Separator/>
                <MenuItem Header="适应窗口" InputGestureText="Ctrl+0" Click="BtnFitToWindow_Click"/>
                <MenuItem Header="实际大小" InputGestureText="Ctrl+1" Click="BtnActualSize_Click"/>
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Header="关于" Click="MenuItemAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== 主内容区域 ===== -->
        <Grid Grid.Row="1" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colInfo" Width="0" MinWidth="0"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="colInput" Width="340" MinWidth="280"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"/>

            <!-- ===== 左侧：模板信息面板 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="模板信息" Style="{StaticResource PanelHeaderTextStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE76E;"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="24" Height="24" Padding="0"
                                    Click="ToggleInfoPanel_Click" ToolTip="折叠/展开面板"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                        <StackPanel x:Name="templateInfoPanel">
                            <TextBlock Text="未加载模板" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,40,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12" Background="{StaticResource BgPanelBrush}"
                            CornerRadius="0,0,6,6">
                        <Button Content="&#xE8A5;  加载模板" Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnLoadTemplate_Click" HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 中间：数据录入面板 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="数据录入" Style="{StaticResource PanelHeaderTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel x:Name="inputControlPanel" Margin="4">
                            <TextBlock Text="请先加载模板" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,40,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,10" Background="{StaticResource BgPanelBrush}"
                            CornerRadius="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="inputStatusText" Text="就绪"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="&#xE8A5; 生成导入模板"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnGenerateSampleXlsx_Click" FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 右侧：TabControl (预览 / 批量导入) ===== -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="报告预览" Style="{StaticResource PanelHeaderTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 工具栏 -->
                    <Border Grid.Row="1" Padding="6,6" Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE700;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="显示/隐藏模板信息面板" Click="ToggleInfoPanel_Click"/>
                                <Rectangle Width="1" Fill="{StaticResource DividerBrush}"
                                           Margin="6,6" VerticalAlignment="Stretch"/>
                                <Button Content="&#xE739;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="缩小 (Ctrl + -)" Click="BtnZoomOut_Click"/>
                                <Slider x:Name="zoomSlider" Width="100" Minimum="15" Maximum="300" Value="100"
                                        TickFrequency="25" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="4,0"
                                        ValueChanged="ZoomSlider_ValueChanged"/>
                                <Button Content="&#xE73A;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="放大 (Ctrl + +)" Click="BtnZoomIn_Click"/>
                                <Rectangle Width="1" Fill="{StaticResource DividerBrush}"
                                           Margin="6,6" VerticalAlignment="Stretch"/>
                                <Button Content="&#xE740;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="适应窗口 (Ctrl + 0)" Click="BtnFitToWindow_Click"/>
                                <Button Content="&#xE81E;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="实际大小 (Ctrl + 1)" Click="BtnActualSize_Click"/>
                                <Rectangle Width="1" Fill="{StaticResource DividerBrush}"
                                           Margin="6,6" VerticalAlignment="Stretch"/>
                                <Button Content="&#xE777;" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="刷新预览 (F5)" Click="BtnRefresh_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="zoomPercentText" Text="100%"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           MinWidth="36" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TabControl -->
                    <TabControl Grid.Row="2" Margin="0" Background="{StaticResource BgPanelBrush}"
                                BorderThickness="0">
                        <TabItem Header="  预览  ">
                            <Border AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
                                    Background="{StaticResource BgPanelBrush}">
                                <ScrollViewer x:Name="previewScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="20" Background="{StaticResource BgPanelBrush}">
                                    <Border x:Name="previewContainer" Background="White"
                                            BorderBrush="#D0D5DD" BorderThickness="1"
                                            CornerRadius="2" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1A000000" BlurRadius="20"
                                                              ShadowDepth="4" Direction="270" Opacity="0.15"/>
                                        </Border.Effect>
                                        <Canvas x:Name="canvasPreview" Background="White"
                                                Width="600" Height="800"/>
                                    </Border>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <TabItem Header="  批量导入  ">
                            <Border Background="{StaticResource BgCardBrush}" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="批量数据导入" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="从 Excel (xlsx/csv) 批量导入数据，逐行校验并匹配模板字段"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,16" TextWrapping="Wrap"/>

                                        <!-- Step 1: 生成模板 -->
                                        <Border Background="{StaticResource BgPanelBrush}" CornerRadius="6"
                                                Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="第一步：生成导入模板" FontSize="13"
                                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBlock Text="将所有可编辑字段扁平化为单行表头，生成空白 xlsx 文件用于批量填写数据"
                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <Button Content="&#xE8A5;  生成导入模板 (xlsx)"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="BtnGenerateSampleXlsx_Click" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Step 2: 导入并校验 -->
                                        <Border Background="{StaticResource BgPanelBrush}" CornerRadius="6"
                                                Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="第二步：导入数据文件" FontSize="13"
                                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="batchFilePathBox"
                                                             IsReadOnly="True" Height="30" VerticalContentAlignment="Center"
                                                             FontSize="12" Background="White"
                                                             Text="未选择文件..."/>
                                                    <Button Grid.Column="1" Content="&#xE8A5; 选择文件"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="BtnSelectBatchFile_Click" Margin="8,0,0,0"/>
                                                </Grid>
                                                <Button Content="&#xE777;  导入并校验数据"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="BtnImportAndValidate_Click" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="batchValidateResult" Text=""
                                                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Step 3: 批量预览 -->
                                        <Border Background="{StaticResource BgPanelBrush}" CornerRadius="6"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="第三步：逐份预览或批量生成" FontSize="13"
                                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="数据行:" VerticalAlignment="Center"
                                                               FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="batchRowInfoText" Text="0 条"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" / 当前:" VerticalAlignment="Center"
                                                               FontSize="12" Margin="8,0,8,0"/>
                                                    <TextBox x:Name="batchRowIndexBox" Text="1"
                                                             Width="50" Height="28" VerticalContentAlignment="Center"
                                                             TextAlignment="Center" FontSize="12"/>
                                                    <Button Content="应用此行数据" Margin="8,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="BtnApplyBatchRow_Click"/>
                                                </StackPanel>
                                                <Button Content="&#xE8B1;  批量生成 PDF 文件"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Click="BtnBatchGeneratePdf_Click" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="batchGenerateResult" Text=""
                                                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <!-- 预览信息栏 -->
                    <Border Grid.Row="3" Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="14,6" CornerRadius="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="previewInfoText"
                                       Text="尺寸: 600 × 800 px" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="更新: " FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lastUpdateText" Text="--:--:--" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="statusIndicator" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="statusText" Text="就绪"
                               VerticalAlignment="Center"/>
                </Grid>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="templateInfoText" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
