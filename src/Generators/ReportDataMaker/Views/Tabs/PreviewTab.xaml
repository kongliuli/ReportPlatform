<UserControl x:Class="ReportDataMaker.Views.Tabs.PreviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新预览" Command="{Binding RefreshPreviewCommand}" Margin="0,0,8,0"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16">
                <TextBlock Text="预览区域" Foreground="Gray" FontSize="18"
                           HorizontalAlignment="Center" Margin="100"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
