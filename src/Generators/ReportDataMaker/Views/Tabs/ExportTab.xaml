<UserControl x:Class="ReportDataMaker.Views.Tabs.ExportTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <GroupBox Header="单份导出" Margin="0,0,0,16">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <Button Content="导出 PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Margin="0,0,8,0"/>

                </StackPanel>
            </GroupBox>

            <GroupBox Header="批量导出" Margin="0,0,0,16">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="数据源" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DataSourceNames}" SelectedItem="{Binding SelectedDataSource}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="输出目录" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseOutputDirCommand}"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="命名规则" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FileNamePattern}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="index date name" Foreground="Gray" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding ProgressValue}" Margin="0,0,0,8"
                                     Visibility="{Binding IsExporting, Converter={StaticResource Boolean2VisibilityConverter}}"/>

                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="开始批量导出"
                                Command="{Binding BatchExportCommand}"
                                IsEnabled="{Binding IsExporting, Converter={StaticResource Boolean2BooleanReConverter}}"
                                Style="{StaticResource ButtonPrimary}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="导出历史" Margin="0,0,0,16">
                <StackPanel Margin="8">
                    <Button Content="刷新" Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding ExportHistory}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="导出时间" Binding="{Binding ExportTime}" Width="*"/>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="*"/>
                            <DataGridTextColumn Header="模板名称" Binding="{Binding TemplateName}" Width="*"/>
                            <DataGridTextColumn Header="记录数" Binding="{Binding RecordCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
