@page "/export"
@inject IPdfService PdfService

<PageTitle>导出 - 报告数据制作</PageTitle>

<h2>导出</h2>

<p>导出功能需要连接后端服务。</p>

<div class="export-options">
    <div class="card">
        <h3>PDF 导出</h3>
        <p>将报告导出为 PDF 文件。</p>
        <button class="btn btn-primary" disabled>导出 PDF</button>
    </div>
    <div class="card">
        <h3>批量导出</h3>
        <p>从 Excel 批量导入数据并导出 PDF。</p>
        <button class="btn btn-primary" disabled>批量导出</button>
    </div>
</div>
