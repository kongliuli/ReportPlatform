@page "/preview"
@inject ITemplateService TemplateService
@inject IPdfService PdfService

<PageTitle>预览 - 报告数据制作</PageTitle>

<h2>PDF 预览</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message">@errorMessage</div>
}

<div class="toolbar">
    <button @onclick="GeneratePreview" class="btn btn-primary" disabled="@isGenerating">
        @(isGenerating ? "生成中..." : "生成预览")
    </button>
</div>

@if (pdfBytes != null)
{
    <div class="preview-container">
        <iframe src="@($"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}")"
                width="100%" height="600px" />
    </div>
}
else
{
    <p class="empty-state">暂无预览内容。请先录入数据并生成预览。</p>
}

@code {
    private byte[]? pdfBytes;
    private bool isGenerating;
    private string errorMessage = string.Empty;

    private async Task GeneratePreview()
    {
        isGenerating = true;
        errorMessage = string.Empty;
        try
        {
            var template = await TemplateService.GetLatestTemplateAsync();
            if (template != null && Guid.TryParse(template.Id, out var templateId))
            {
                var data = new Dictionary<string, object>();
                pdfBytes = await PdfService.RenderPdfAsync(templateId, data);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"生成预览失败: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }
}
