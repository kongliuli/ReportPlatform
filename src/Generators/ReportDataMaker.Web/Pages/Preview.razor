@page "/preview"
@inject ITemplateService TemplateService
@inject IPdfService PdfService

<PageTitle>预览 - 报告数据制作</PageTitle>

<h2>PDF 预览</h2>

<p>预览功能需要连接后端服务。</p>

@if (pdfBytes != null)
{
    <div class="preview-container">
        <iframe src="@($"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}")"
                width="100%" height="600px" />
    </div>
}
else
{
    <p class="empty-state">暂无预览内容。请先录入数据并生成预览。</p>
}

@code {
    private byte[]? pdfBytes;
}
