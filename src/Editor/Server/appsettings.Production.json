{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "${DB_PROVIDER}",
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=xinglin_webreport.db",
    "SqlServerConnection": "Server=${DB_SERVER};Database=${DB_NAME};User ID=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "Xinglin.WebReportEditor",
    "Audience": "Xinglin.WebReportEditor.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "${ALLOWED_ORIGINS}"
    ]
  },
  "Swagger": {
    "Enabled": false
  }
}