{
  "id": "template_master_report_v2",
  "name": "标准报告母模板",
  "type": "report",
  "description": "标准医疗报告母模板（WPF 兼容 v2.2），包含页眉、页脚、标题区域和内容区域",
  "version": "2.2.0",
  "pageWidth": 210,
  "pageHeight": 297,
  "orientation": "portrait",
  "margins": {
    "top": 20,
    "bottom": 20,
    "left": 15,
    "right": 15
  },
  "backgroundColor": "#FFFFFF",
  "globalFontSize": 12,
  "elements": [
    {
      "id": "el_header_main",
      "x": 10,
      "y": 5,
      "width": 190,
      "height": 25,
      "isVisible": true,
      "content": "{{Hospital}} - {{Department}}",
      "showOnAllPages": true,
      "fontSize": 10,
      "fontFamily": "SimSun",
      "foregroundColor": "#909399",
      "textAlignment": "center",
      "$type": "template.element.header"
    },
    {
      "id": "el_title",
      "x": 10,
      "y": 30,
      "width": 190,
      "height": 25,
      "isVisible": true,
      "text": "{{Title}}",
      "fontSize": 18,
      "fontFamily": "SimHei",
      "fontWeight": "bold",
      "foregroundColor": "#1F2329",
      "textAlignment": "center",
      "$type": "template.element.text"
    },
    {
      "id": "el_divider_1",
      "x": 10,
      "y": 58,
      "width": 190,
      "height": 10,
      "isVisible": true,
      "dividerStyle": "solid",
      "thickness": 1,
      "color": "#E4E7ED",
      "$type": "template.element.divider"
    },
    {
      "id": "el_patient_name_label",
      "x": 10,
      "y": 70,
      "width": 60,
      "height": 20,
      "isVisible": true,
      "text": "姓名：",
      "fontSize": 12,
      "fontWeight": "bold",
      "foregroundColor": "#303133",
      "$type": "template.element.text"
    },
    {
      "id": "el_patient_name",
      "x": 70,
      "y": 70,
      "width": 80,
      "height": 20,
      "isVisible": true,
      "text": "",
      "fontSize": 12,
      "foregroundColor": "#606266",
      "label": "姓名",
      "dataPath": "PatientName",
      "$type": "template.element.text"
    },
    {
      "id": "el_patient_gender_label",
      "x": 160,
      "y": 70,
      "width": 30,
      "height": 20,
      "isVisible": true,
      "text": "性别：",
      "fontSize": 12,
      "fontWeight": "bold",
      "foregroundColor": "#303133",
      "$type": "template.element.text"
    },
    {
      "id": "el_patient_gender",
      "x": 190,
      "y": 70,
      "width": 15,
      "height": 20,
      "isVisible": true,
      "value": "",
      "options": ["男", "女"],
      "placeholder": "请选择",
      "label": "性别",
      "dataPath": "Gender",
      "$type": "template.element.dropdown"
    },
    {
      "id": "el_patient_age_label",
      "x": 10,
      "y": 95,
      "width": 60,
      "height": 20,
      "isVisible": true,
      "text": "年龄：",
      "fontSize": 12,
      "fontWeight": "bold",
      "foregroundColor": "#303133",
      "$type": "template.element.text"
    },
    {
      "id": "el_patient_age",
      "x": 70,
      "y": 95,
      "width": 40,
      "height": 20,
      "isVisible": true,
      "value": 0,
      "unit": "岁",
      "label": "年龄",
      "dataPath": "Age",
      "$type": "template.element.number"
    },
    {
      "id": "el_divider_2",
      "x": 10,
      "y": 120,
      "width": 190,
      "height": 10,
      "isVisible": true,
      "dividerStyle": "dashed",
      "thickness": 1,
      "color": "#E4E7ED",
      "$type": "template.element.divider"
    },
    {
      "id": "el_report_title",
      "x": 10,
      "y": 135,
      "width": 190,
      "height": 20,
      "isVisible": true,
      "text": "检查结果",
      "fontSize": 14,
      "fontFamily": "SimHei",
      "fontWeight": "bold",
      "foregroundColor": "#1F2329",
      "$type": "template.element.text"
    },
    {
      "id": "el_report_table",
      "x": 10,
      "y": 160,
      "width": 190,
      "height": 80,
      "isVisible": true,
      "rows": 5,
      "columns": 4,
      "hasHeader": true,
      "cellPadding": 4,
      "cellData": [
        ["项目名称", "检查结果", "参考值", "单位"],
        ["{{Items[0].Name}}", "{{Items[0].Result}}", "{{Items[0].Reference}}", "{{Items[0].Unit}}"],
        ["{{Items[1].Name}}", "{{Items[1].Result}}", "{{Items[1].Reference}}", "{{Items[1].Unit}}"],
        ["{{Items[2].Name}}", "{{Items[2].Result}}", "{{Items[2].Reference}}", "{{Items[2].Unit}}"],
        ["{{Items[3].Name}}", "{{Items[3].Result}}", "{{Items[3].Reference}}", "{{Items[3].Unit}}"]
      ],
      "$type": "template.element.table"
    },
    {
      "id": "el_conclusion_title",
      "x": 10,
      "y": 245,
      "width": 190,
      "height": 20,
      "isVisible": true,
      "text": "结论",
      "fontSize": 14,
      "fontFamily": "SimHei",
      "fontWeight": "bold",
      "foregroundColor": "#1F2329",
      "$type": "template.element.text"
    },
    {
      "id": "el_conclusion_content",
      "x": 10,
      "y": 268,
      "width": 190,
      "height": 20,
      "isVisible": true,
      "text": "",
      "fontSize": 12,
      "fontFamily": "SimSun",
      "foregroundColor": "#606266",
      "label": "结论",
      "dataPath": "Conclusion",
      "$type": "template.element.text"
    },
    {
      "id": "el_footer_main",
      "x": 10,
      "y": 275,
      "width": 190,
      "height": 20,
      "isVisible": true,
      "content": "报告编号：{{ReportNumber}} | 报告日期：{{ReportDate}}",
      "showOnAllPages": true,
      "showPageNumber": true,
      "fontSize": 10,
      "fontFamily": "SimSun",
      "foregroundColor": "#909399",
      "textAlignment": "center",
      "$type": "template.element.footer"
    }
  ],
  "createdAt": "2026-05-07T00:00:00Z",
  "updatedAt": "2026-05-07T00:00:00Z",
  "isPublished": true
}
