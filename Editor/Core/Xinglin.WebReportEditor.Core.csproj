<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Xinglin.WebReportEditor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xinglin.WebReportEditor.Contracts\Xinglin.WebReportEditor.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../libs/Xinglin.Core.dll')">
    <Reference Include="Xinglin.Core">
      <HintPath>..\libs\Xinglin.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xinglin.Infrastructure">
      <HintPath>..\libs\Xinglin.Infrastructure.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xinglin.Security">
      <HintPath>..\libs\Xinglin.Security.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
